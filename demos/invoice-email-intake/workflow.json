([0-9]+(?:\\.[0-9]{1,2})?)/i)); } if (!invoiceNumber) errors.push({ field: 'invoiceNumber', message: 'not found' }); if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || Number.isNaN(Date.parse(date + 'T00:00:00Z'))) errors.push({ field: 'date', message: 'use YYYY-MM-DD' }); if (!vendor) errors.push({ field: 'vendor', message: 'not found' }); if (!Number.isFinite(amount) || amount <= 0) errors.push({ field: 'amount', message: 'must be positive' }); if (errors.length) return [{ json: { valid: false, idempotencyKey: key || 'invalid-email', source: { emailId: input.emailId || null, fileName }, response: { ok: false, error: 'ATTACHMENT_PARSE_FAILED', details: errors } } }]; return [{ json: { valid: true, idempotencyKey: key, invoice: { invoiceNumber, date, amount, vendor, sourceFile: fileName, threshold: Number(input.reviewThreshold || 50000) } } }];"
